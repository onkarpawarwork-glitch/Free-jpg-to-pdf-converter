---
import ContentPage from '../components/ContentPage.astro';
---

<ContentPage
	title="Contact"
	description="Support availability and privacy information for JPG to PDF Online."
	eyebrow="Get in touch"
>
	<section aria-labelledby="contact-support"><h2 id="contact-support" class="text-xl font-semibold tracking-tight text-ink">Support availability</h2><p class="mt-2">This site does not currently publish a support email address or accept contact form submissions. For information about how selected images are handled, see the privacy page.</p></section>
	<p>For general details about local image processing, see the <a class="text-ink-muted underline underline-offset-4 hover:text-white" href="/privacy/">privacy page</a>. To return to the tool, go to the <a class="text-ink-muted underline underline-offset-4 hover:text-white" href="/#converter">homepage converter</a>.</p>
</ContentPage>
