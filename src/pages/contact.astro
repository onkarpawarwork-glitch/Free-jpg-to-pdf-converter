---
import ContentPage from '../components/ContentPage.astro';
---

<ContentPage
	title="Contact"
	description="Contact JPG to PDF Online with questions, bug reports, or feedback. Please do not email sensitive documents or personal information."
	eyebrow="Get in touch"
>
	<section aria-labelledby="contact-support"><h2 id="contact-support" class="text-xl font-semibold tracking-tight text-ink">Questions, bug reports, and feedback</h2><p class="mt-2">For questions about the converter, to report a bug, or to share feedback, email <a class="text-ink-muted underline underline-offset-4 hover:text-ink" href="mailto:support.ashasoftware@gmail.com">support.ashasoftware@gmail.com</a>.</p></section>
	<section aria-labelledby="contact-privacy"><h2 id="contact-privacy" class="text-xl font-semibold tracking-tight text-ink">Protect your privacy</h2><p class="mt-2">Please do not send sensitive documents or personal information by email.</p></section>
	<p>For general details about local image processing, see the <a class="text-ink-muted underline underline-offset-4 hover:text-ink" href="/privacy/">privacy page</a>. To return to the tool, go to the <a class="text-ink-muted underline underline-offset-4 hover:text-ink" href="/#converter">homepage converter</a>.</p>
</ContentPage>
